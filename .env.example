# PostgreSQL. En local (docker) o en Supabase.
DATABASE_URL=postgresql://flowcommerce:flowcommerce@localhost:5432/flowcommerce_dev
POSTGRES_PORT=5432
POSTGRES_DB=flowcommerce_dev
PORT=3000

# --- Supabase ---------------------------------------------------------------
# Base de datos (Project Settings -> Database -> Connection string):
#   DATABASE_URL: la del pooler "Transaction" (puerto 6543) para la API, con
#                 ?sslmode=require. Con ese puerto el driver desactiva los
#                 prepared statements solo.
#   DIRECT_URL:   la conexión directa (puerto 5432), SOLO para migraciones
#                 (pnpm db:migrate / db:generate). Si se omite se usa DATABASE_URL.
# DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# DATABASE_PREPARE=false     # fuerza prepared statements desactivados
# DATABASE_POOL_MAX=10       # conexiones del pool de la API

# Proyecto (Project Settings -> API).
# SUPABASE_URL=https://<ref>.supabase.co
# Clave service_role: SOLO en el servidor. Se salta RLS y todos los permisos:
# nunca en el frontend ni en git.
# SUPABASE_SERVICE_ROLE_KEY=
# Solo si el proyecto aun firma los JWT con el secreto compartido (HS256). Los
# proyectos nuevos usan claves asimetricas (JWKS) y no la necesitan.
# SUPABASE_JWT_SECRET=
# A donde lleva el enlace del correo de invitacion (pantalla de definir
# contrasena). Por defecto APP_URL.
# SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173/auth/set-password
# Bucket PRIVADO de Storage (FILE_STORAGE_DRIVER=supabase).
# SUPABASE_STORAGE_BUCKET=uploads

# Auth: el login, el registro y la recuperacion de contrasena los hace el
# frontend con supabase-js; la API solo verifica el access token
# (Authorization: Bearer <jwt>). Si el acceso es solo por invitacion,
# desactiva "Allow new users to sign up" en Authentication -> Providers -> Email.

# CORS
# Orígenes del frontend autorizados (separados por comas). Si se omite se usa APP_URL.
# Nunca '*': la sesión viaja en cookie y requiere credentials.
CORS_ORIGINS=http://localhost:5173

# Password recovery
# URL base del frontend que recibe ?token en el enlace de reset (obligatoria en production).
APP_URL=http://localhost:5173
# Requeridas para envío de correos vía Resend. Sin ellas (dev) se usa ConsoleEmailSender.
RESEND_API_KEY=
EMAIL_FROM=no-reply@flowcommerce.com

# WhatsApp Cloud API
# Token y phone_number_id de Graph. Nunca se aceptan por HTTP.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
# Opcional: override del host de Graph (tests).
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BASE_MS=250
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Webhooks de Meta. Callback: POST/GET /api/v1/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Tenant al que pertenece este WABA. El envío y el inbound se acotan a este projectId.
WHATSAPP_PROJECT_ID=

# Seguridad HTTP
# Número de proxies delante de la API (Render, Railway, Nginx…): "1" en la
# mayoría de hostings. Vacío en local. Necesario para que el rate limiting vea
# la IP real del cliente.
TRUST_PROXY=
# Swagger en /docs: activo fuera de producción. En producción solo con true.
SWAGGER_ENABLED=
# Límite de peticiones por IP en los endpoints públicos (login, registro,
# recuperar contraseña, solicitar acceso, invitaciones). false lo desactiva.
THROTTLE_ENABLED=true
# Opcionales: THROTTLE_<LOGIN|SIGNUP|FORGOT_PASSWORD|RESET_PASSWORD|ACCESS_REQUEST|INVITATION>_LIMIT y _TTL_MS
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_LOGIN_TTL_MS=60000

# Tareas programadas (recordatorios de seguimientos vencidos y de cotizaciones
# enviadas que vencieron, cada 10 minutos). false lo apaga.
SCHEDULER_ENABLED=true

# WhatsApp: id de la cuenta de WhatsApp Business (WABA) para listar las
# plantillas aprobadas (WhatsApp Manager → Configuración de la cuenta).
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Archivos (foto de perfil y adjuntos). Elección EXPLÍCITA del almacenamiento:
# "local" (carpeta del servidor) o "supabase" (Supabase Storage, bucket privado).
FILE_STORAGE_DRIVER=local
# Carpeta para el driver local (relativa al proyecto). No se sube a git.
UPLOADS_DIR=uploads

# Integración con el equipo de Pagos (ver README → "Contratos con IA y Pagos").
# Servicio que crea los links de pago: POST {URL}/payment-links con Bearer token.
PAYMENTS_SERVICE_URL=
PAYMENTS_SERVICE_TOKEN=
# Secreto compartido para firmar el webhook POST /api/v1/integrations/payments/webhook
PAYMENTS_WEBHOOK_SECRET=

# Cifrado de secretos guardados en BD (token de WhatsApp por proyecto, secreto
# de firma de webhooks salientes). 64 caracteres hex = 32 bytes (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotarla deja ilegibles los secretos anteriores: hay que volver a guardarlos.
ENCRYPTION_KEY=

# true = POST /projects/:id/whatsapp/templates no llama a Meta (desarrollo/CI).
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Webhooks salientes (POST firmado a las URLs que registre cada proyecto).
# false los apaga por completo.
WEBHOOKS_ENABLED=true
# Solo desarrollo: permite http:// y receptores en localhost/red privada.
# Se ignora si NODE_ENV=production. Nunca activarlo en un servidor publico.
# WEBHOOKS_ALLOW_PRIVATE_TARGETS=true
# Opcionales: WEBHOOKS_MAX_ATTEMPTS=3, WEBHOOKS_RETRY_BASE_MS=1000, WEBHOOKS_TIMEOUT_MS=10000
